ZALO_MODE=personal
TELEGRAM_BOT_TOKEN=
# Lấy id: tắt bridge → npm run telegram:ids → /id trong group/channel/chat riêng
# hoặc: npm run telegram:chat -- -100…   /  npm run telegram:chat -- @channel
TELEGRAM_FORUM_GROUP_ID=
# Một hoặc nhiều channel (phẩy): -100111,-100222
TELEGRAM_CHANNEL_ID=
# Bắt buộc — một hoặc nhiều admin user id (phẩy): 111,222
TELEGRAM_ADMIN_IDS=

# mode=bot
ZALO_BOT_TOKEN=
# polling = local/dev (default when NODE_ENV != production)
# webhook = production HTTPS — cần ZALO_BOT_WEBHOOK_SECRET
# ZALO_BOT_TRANSPORT=polling
ZALO_BOT_WEBHOOK_PATH=/webhooks/zalo
ZALO_BOT_WEBHOOK_SECRET=
ZALO_BOT_POLL_TIMEOUT_SEC=30
PORT=3080

# mode=personal
ZALO_SESSION_PATH=./data/zalo-session.json
ZALO_MIN_SEND_INTERVAL_MS=1500
ZALO_SEND_MAX_PER_MINUTE=20

JOB_MAX_RETRIES=3
LIST_PAGE_SIZE=20

# Chữ ký dưới mỗi tin chuyển tiếp (tuỳ chọn). Để trống = tắt. Runtime: /signature
# FORWARD_SIGNATURE=via tg-zalo

DATABASE_PATH=./data/bridge.db
LOG_LEVEL=info
