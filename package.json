{
  "name": "tg-zalo",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram ↔ Zalo bridge (topic inbox + channel broadcast)",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "zalo:login": "tsx src/zalo/personal/login.ts",
    "telegram:ids": "tsx src/telegram/discover-ids.ts",
    "telegram:chat": "tsx src/telegram/discover-ids.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart tg-zalo",
    "pm2:logs": "pm2 logs tg-zalo",
    "pm2:stop": "pm2 stop tg-zalo"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "grammy": "^1.36.1",
    "image-size": "^2.0.4",
    "pino": "^10.3.1",
    "zca-js": "^2.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/image-size": "^0.7.0",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
